# ==========================================
# GBP OPTIMIZER - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. DATABASE CONFIGURATION
# Local SQLite/LibSQL database path (auto-configured by default)
DATABASE_URL=file:data/local.db

# 2. GOOGLE GEMINI API (AI Studio & Geo-Grid Recommendations)
# Get your free key instantly from: https://aistudio.google.com/app/apikey
# Used for: Business descriptions, smart review replies, and geo-grid rank expansion recommendations
GEMINI_API_KEY=

# 3. GOOGLE PLACES API (Business Search, Auto-Fill & Live Geo-Grid Tracking)
# Get from Google Cloud Console -> APIs & Services -> Enable "Places API (New)"
# Used for: Auto-complete onboarding search and live multi-coordinate 3x3/5x5 Geo-Grid ranking scans
GOOGLE_PLACES_API_KEY=

# 4. GOOGLE OAUTH 2.0 (Official GBP Profile Sync & Direct Publishing)
# Get from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# 5. PUBLIC APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 6. RUNTIME ENVIRONMENT
NODE_ENV=development
