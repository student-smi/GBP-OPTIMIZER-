# ==========================================
# GBP OPTIMIZER - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE CONFIGURATION
# Local SQLite/LibSQL database path (auto-configured by default)
DATABASE_URL=file:data/local.db

# 2. GOOGLE GEMINI API (LLM Content Studio)
# Get your free key instantly from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. GOOGLE PLACES API (Business Search & Auto-Fill)
# Create in Google Cloud Console: Enable "Places API (New)" and create an API Key
GOOGLE_PLACES_API_KEY=

# 4. GOOGLE OAUTH 2.0 (Connect Google Account)
# Create in Google Cloud Console: Credentials -> OAuth 2.0 Client ID -> Web Application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. ENVIRONMENT
NODE_ENV=development
